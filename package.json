{
  "name": "bug-battle-3d",
  "version": "0.1.0",
  "private": true,
  "description": "A browser remake of a snake-vs-bug arena game, built with three.js.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:ascii": "node scripts/check-ascii.mjs",
    "check:assets": "node scripts/verify-assets.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:ascii && npm run check:assets && npm run test"
  },
  "dependencies": {
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^79.0.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
